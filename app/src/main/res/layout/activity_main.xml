<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar en haut -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:background="@drawable/fayow_bandeau_haut"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title=""
        app:titleTextColor="@android:color/white"
        app:subtitle=""
        app:subtitleTextColor="@android:color/white" />

    <!-- MapView custom : intercepte les touches avant Google Maps -->
    <com.example.fayowdemo.ui.map.InterceptMapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnModeration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Bouton Modération -->
    <Button
        android:id="@+id/btnModeration"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="0dp"
        android:text="Modération"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/toolbarBottom"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bouton Ajouter POI -->
    <Button
        android:id="@+id/btn_add_poi"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="0dp"
        android:text="Ajouter Anecdote"
        app:layout_constraintBottom_toTopOf="@id/toolbarBottom"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barre du bas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarBottom"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/fayow_bandeau_bas"
        android:elevation="8dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <!--
            btnReafficher : aligné à gauche
            btnParcourir  : aligné à droite
            Ils sont côte à côte sur la même ligne (constraintTop_toTopOf="parent").
            Le texte de btnParcourir est géré dynamiquement depuis MainActivity.kt :
              - Mode normal  → getString(R.string.btn_parcourir)  "🗺️ Parcourir mes anecdotes"
              - Mode Parcourir → getString(R.string.btn_retour)   "⬅️ Retour à la carte"
        -->

        <!-- Bouton Réafficher (gauche) -->
        <Button
            android:id="@+id/btnReafficher"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/design_default_color_primary"
            android:text="@string/btn_reafficher"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/btnParcourir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5" />

        <!-- Bouton Parcourir (droite) — texte piloté depuis MainActivity -->
        <Button
            android:id="@+id/btnParcourir"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/design_default_color_primary"
            android:text="@string/btn_parcourir"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnReafficher"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5" />

        <!-- Bouton Déconnexion (bas droite) -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FF5252"
            android:text="Déconnexion"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnParcourir"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>